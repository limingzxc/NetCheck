<Window x:Class="NetCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetCheck 网络体检" Height="880" Width="1240"
        MinHeight="620" MinWidth="960"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <DockPanel>

    <!-- ==================== 应用标题栏 ==================== -->
    <Border DockPanel.Dock="Top" Style="{StaticResource AppBarArea}" Height="56">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 标识 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusBlock}"
                  Background="{DynamicResource AccentBgBrush}">
            <Path Data="M3.5,11 L7.5,11 L9.5,5 L12.5,17 L14.5,9 L16.5,11 L18.5,11"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="NetCheck" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="网络体检" FontSize="10.5" Margin="0,-1,0,0"
                       Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>

        <!-- 分隔线 -->
        <Border Grid.Column="1" Width="1" Margin="20,14,16,14"
                Background="{DynamicResource LineBrush}"/>

        <!-- 菜单 -->
        <Menu Grid.Column="2" x:Name="MainMenu" VerticalAlignment="Center"
              Style="{StaticResource AppMenu}"
              ItemContainerStyle="{StaticResource AppMenuItem}">
          <MenuItem Header="文件(_F)">
            <MenuItem Header="导出报告…" InputGestureText="Ctrl+S" Click="BtnSave_Click"/>
            <MenuItem Header="复制全文" InputGestureText="Ctrl+C" Click="BtnCopy_Click"/>
            <MenuItem Header="导出诊断包…" InputGestureText="Ctrl+B" Click="BtnBundle_Click"/>
            <MenuItem Header="导出诊断包（脱敏）…" InputGestureText="Ctrl+Shift+B" Click="BtnBundleMasked_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <MenuItem Header="打开配置目录" Click="MenuOpenSettings_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <MenuItem Header="退出" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
          </MenuItem>

          <MenuItem x:Name="MenuDetect" Header="检测(_R)"
                    SubmenuOpened="MenuDetect_SubmenuOpened">
            <MenuItem Header="一键检测" InputGestureText="F5" Click="BtnQuick_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <MenuItem Header="重新读取本机配置" Click="BtnLocal_Click"/>
            <MenuItem Header="出口 IP 检测" Click="BtnEgress_Click"/>
            <MenuItem Header="延迟检测" Click="BtnLatency_Click"/>
            <MenuItem Header="带宽测速" Click="BtnSpeed_Click"/>
            <MenuItem Header="DNS 检测" Click="BtnDns_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <MenuItem Header="IPv6 检测" Click="BtnIpv6_Click"/>
            <MenuItem Header="网页连通性检测" Click="BtnWeb_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <MenuItem Header="NAT 类型检测" Click="BtnNat_Click"/>
            <MenuItem Header="路由追踪" Click="BtnTrace_Click"/>
            <MenuItem Header="MTU 探测" Click="BtnMtu_Click"/>
            <MenuItem Header="端口检测" Click="BtnPort_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <!-- Tag 供 MenuDetect_SubmenuOpened 识别：忙碌时这一项要留着可点 -->
            <MenuItem Header="取消当前检测" InputGestureText="Esc" Tag="cancel" Click="BtnCancel_Click"/>
          </MenuItem>

          <MenuItem x:Name="MenuView" Header="视图(_V)">
            <MenuItem Header="检测选项" Click="MenuShowOptions_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <!-- 快速对调，和标题栏右侧那个按钮、Ctrl+T 是同一件事 -->
            <MenuItem Header="切换浅色 / 深色" InputGestureText="Ctrl+T" Click="MenuToggleTheme_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <!-- 主题三选一。Tag 就是配置文件里存的那个字符串，改这里要同步 Theme.FromSetting。 -->
            <MenuItem x:Name="MenuThemeSystem" Header="跟随系统主题" Tag="system"
                      IsCheckable="True" IsChecked="True" Click="MenuTheme_Click"/>
            <MenuItem x:Name="MenuThemeLight" Header="浅色主题" Tag="light"
                      IsCheckable="True" Click="MenuTheme_Click"/>
            <MenuItem x:Name="MenuThemeDark" Header="深色主题" Tag="dark"
                      IsCheckable="True" Click="MenuTheme_Click"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <!-- 跳转目标由 Tag 决定，不需要 x:Name。
                 Tag 一律写卡片键名而不是数字：数字绑定的是卡片顺序，
                 插一张卡片就要全部跟着改，而且漏改一处不会报错、只会跳到错的卡片。 -->
            <MenuItem Header="概览"     Click="MenuNav_Click" Tag="overview"/>
            <MenuItem Header="本机网络配置" Click="MenuNav_Click" Tag="local"/>
            <MenuItem Header="公网出口 IP" Click="MenuNav_Click" Tag="egress"/>
            <MenuItem Header="连通性"   Click="MenuNav_Click" Tag="link"/>
            <MenuItem Header="DNS"      Click="MenuNav_Click" Tag="dns"/>
            <Separator Style="{StaticResource AppSeparator}"/>
            <MenuItem Header="路径"     Click="MenuNav_Click" Tag="path"/>
            <MenuItem Header="NAT 类型" Click="MenuNav_Click" Tag="nat"/>
            <MenuItem Header="端口"     Click="MenuNav_Click" Tag="port"/>
            <MenuItem Header="IPv4 / IPv6" Click="MenuNav_Click" Tag="ipv6"/>
            <MenuItem Header="HTTP / HTTPS" Click="MenuNav_Click" Tag="web"/>
          </MenuItem>

          <MenuItem Header="帮助(_H)">
            <MenuItem Header="使用说明" Click="MenuHelp_Click"/>
            <MenuItem Header="关于 NetCheck" Click="MenuAbout_Click"/>
          </MenuItem>
        </Menu>

        <!-- 主题开关：太阳 / 月亮，只在两种明暗之间快速切换。
             选「跟随系统」要保留下来时走「视图」菜单里的三选项。 -->
        <Button Grid.Column="3" x:Name="BtnTheme" Style="{StaticResource IconButton}"
                Click="BtnTheme_Click" VerticalAlignment="Center"
                AutomationProperties.Name="切换主题"
                ToolTip="切换浅色 / 深色主题">
          <Grid Width="20" Height="20">
            <Path x:Name="IconSun"
                  Data="M10,4.8 A5.2,5.2 0 1,0 10,15.2 A5.2,5.2 0 1,0 10,4.8 Z M10,0.9 L10,2.7 M10,17.3 L10,19.1 M0.9,10 L2.7,10 M17.3,10 L19.1,10 M3.6,3.6 L4.9,4.9 M15.1,15.1 L16.4,16.4 M16.4,3.6 L15.1,4.9 M4.9,15.1 L3.6,16.4"
                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                  Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path x:Name="IconMoon" Visibility="Collapsed"
                  Data="M13.4,1.4 A8.2,8.2 0 1,0 18.6,14.9 A6.5,6.5 0 0,1 13.4,1.4 Z"
                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                  Fill="Transparent" StrokeLineJoin="Round"/>
          </Grid>
        </Button>
      </Grid>
    </Border>

    <!-- ==================== 工具栏 ====================
         只放「全局动作」。各项检测的运行入口在右侧详情面板的头部，
         和它要填充的内容在一起 —— 同一个功能不再出现在两个地方。 -->
    <Border DockPanel.Dock="Top" Style="{StaticResource ToolBarArea}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
          <Button x:Name="BtnQuick" Content="一键检测" Style="{StaticResource PrimaryButton}"
                  Click="BtnQuick_Click"
                  ToolTip="本机配置 + 出口 IP + DNS + 延迟，约 6 秒（F5）"/>
          <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource SoftButton}"
                  Click="BtnCancel_Click" IsEnabled="False" ToolTip="中断当前检测（Esc）"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnCopy" Content="复制全文" Style="{StaticResource GhostButton}"
                  Click="BtnCopy_Click" IsEnabled="False" ToolTip="把完整报告复制到剪贴板（Ctrl+C）"/>
          <Button x:Name="BtnSave" Content="导出报告" Style="{StaticResource GhostButton}"
                  Click="BtnSave_Click" IsEnabled="False" ToolTip="导出为 txt 或 json（Ctrl+S）"/>
          <Button x:Name="BtnBundle" Content="诊断包" Style="{StaticResource GhostButton}"
                  Click="BtnBundle_Click" IsEnabled="False"
                  ToolTip="报告 + 原始数据 + 系统网络命令输出，打包成 zip（Ctrl+B）"/>
          <Button x:Name="BtnBundleMask" Content="脱敏包" Style="{StaticResource GhostButton}"
                  Click="BtnBundleMasked_Click" IsEnabled="False"
                  ToolTip="同上，但主机名 / MAC / 公网 IP 打码后再打包 —— 要发给别人时用这个（Ctrl+Shift+B）"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== 状态栏 ==================== -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBarArea}">
      <Grid Height="32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 状态点：空闲是中性灰，检测中是主色（由代码切换） -->
        <Border x:Name="StatusDot" Grid.Column="0" Width="7" Height="7"
                CornerRadius="4" Background="{DynamicResource FaintBrush}"
                VerticalAlignment="Center" Margin="0,0,9,0"/>

        <TextBlock x:Name="LblStatus" Grid.Column="1" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="正在读取本机网络配置…"/>

        <TextBlock x:Name="LblSummary" Grid.Column="2" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}"
                   VerticalAlignment="Center" Margin="16,0,14,0"/>

        <ProgressBar x:Name="Bar" Grid.Column="3" Style="{StaticResource FlatProgress}"
                     Width="130" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>
    </Border>

    <!-- ==================== 主体：左导航 + 右详情 ====================
         原来是一列长滚动卡片流：十一个检测项串在一起，找一个项要滚半天，
         而且每张卡片都在跟别人抢注意力。现在一次只看一项，
         左边一列把全部检测项和它们各自的问题数同时摆在眼前。 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="256"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 导航栏。项由 BuildNav() 在代码里生成 —— 状态点和问题角标都要按检测结果刷新，
           用 XAML 写死就没法挂引用了。 -->
      <Border Grid.Column="0" Style="{StaticResource NavRailArea}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavHost" Margin="10,10,10,18"/>
        </ScrollViewer>
      </Border>

      <!-- 详情面板 -->
      <DockPanel Grid.Column="1" Background="{DynamicResource BgBrush}">

        <Border DockPanel.Dock="Top" x:Name="DetailHeader" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="26,18,26,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock x:Name="DetailTitle" FontSize="19" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="DetailHint" FontSize="12" Margin="0,4,0,0"
                         Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <!-- 当前检测项的运行按钮。按钮对象建一次就留着（SetBusy 要改它们的文案），
                 切换检测项时只是把对应的那一组挂到这里。 -->
            <StackPanel x:Name="DetailActions" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="20,0,0,0"/>
          </Grid>
        </Border>

        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
          <StackPanel x:Name="DetailHost" MaxWidth="1080" HorizontalAlignment="Stretch"
                      Margin="26,20,26,26">

          <!--
            检测选项的输入控件。声明在这里是为了保留 x:Name 与设计器预览，
            构造函数里会把它从 DetailHost 摘出来，选中「检测选项」时再挂回去。
          -->
          <StackPanel x:Name="OptionsFields" Visibility="Collapsed">
          <WrapPanel>
            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="目标主机" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtHost" Style="{StaticResource CompactInput}" Margin="0"
                       KeyDown="TxtHost_KeyDown" LostFocus="Options_Changed"
                       ToolTip="路由追踪 / MTU 探测 / 端口检测的目标。填好后按回车直接开始路由追踪"/>
              <TextBlock Text="路由追踪 / MTU / 端口检测使用此目标（回车 = 路由追踪）"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="网页目标" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtWebTarget" Style="{StaticResource CompactInput}" Margin="0"
                       KeyDown="TxtWebTarget_KeyDown" LostFocus="Options_Changed"
                       ToolTip="HTTP / HTTPS 检测额外要测的站点，如 example.com 或 https://example.com/a。留空则只测内置目标"/>
              <TextBlock Text="HTTP / HTTPS 检测使用此域名（可留空，回车 = 立即检测）"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="端口预设" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <ComboBox x:Name="CmbPreset" Style="{StaticResource CompactCombo}" Margin="0"
                        SelectionChanged="CmbPreset_SelectionChanged"/>
              <TextBlock Text="选「自定义」后下面的表达式才完全由你决定"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="端口表达式" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtPorts" Style="{StaticResource CompactInput}" Margin="0"
                       KeyDown="TxtPorts_KeyDown" LostFocus="Options_Changed"
                       ToolTip="逗号 / 空格 / 分号分隔，支持 8000-8010 范围写法。填好后按回车直接开始端口检测"/>
              <TextBlock x:Name="LblPortHint" Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="端口并发数" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtConcurrency" Style="{StaticResource CompactInput}" Margin="0"
                       LostFocus="Options_Changed"/>
              <TextBlock Text="1 ~ 512。过高可能被防火墙判定为扫描"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="端口超时（毫秒）" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtPortTimeout" Style="{StaticResource CompactInput}" Margin="0"
                       LostFocus="Options_Changed"/>
              <TextBlock Text="100 ~ 15000。内网可调小，跨公网建议 1500 以上"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="延迟探测次数" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtRounds" Style="{StaticResource CompactInput}" Margin="0"
                       LostFocus="Options_Changed"/>
              <TextBlock Text="1 ~ 20。次数越多抖动数据越准"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="路由最大跳数" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtMaxHops" Style="{StaticResource CompactInput}" Margin="0"
                       LostFocus="Options_Changed"/>
              <TextBlock Text="1 ~ 64。到公网目标一般 15 跳内就结束了"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="路由单跳超时（毫秒）" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtTraceTimeout" Style="{StaticResource CompactInput}" Margin="0"
                       LostFocus="Options_Changed"/>
              <TextBlock Text="200 ~ 5000。跨公网跳数多、丢包重时调大"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="测速时长（秒）" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtSpeedSeconds" Style="{StaticResource CompactInput}" Margin="0"
                       LostFocus="Options_Changed"/>
              <TextBlock Text="3 ~ 60。时长越长结果越稳，但流量也越多"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12">
              <TextBlock Text="DNS 超时（毫秒）" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
              <TextBox x:Name="TxtDnsTimeout" Style="{StaticResource CompactInput}" Margin="0"
                       LostFocus="Options_Changed"/>
              <TextBlock Text="300 ~ 10000。公共 DNS 通常 2500 足够"
                         Style="{StaticResource OptionHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Width="238" Margin="0,0,16,12" VerticalAlignment="Bottom">
              <Button x:Name="BtnResetOptions" Content="恢复默认选项"
                      Style="{StaticResource SoftButton}" Margin="0,0,0,22"
                      HorizontalAlignment="Stretch"
                      Click="BtnResetOptions_Click"/>
            </StackPanel>
          </WrapPanel>
          </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>

  </DockPanel>
</Window>
